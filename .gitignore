# Ignore everything by default. Only source code and the dependency manifest
# are intended to be committed from this research workspace.
*

# Repository metadata and the two permitted project documents.
!.gitignore
!requirements.txt
!README.md

# Permit Python source files at any directory depth.
!*/
!*.py

# Keep local environments, secrets, caches, notebooks, and temporary files
# ignored. The checked-in data and results snapshots are explicitly allowed
# below for the requested GitHub upload.
.venv/
.matplotlib/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.env
temp.txt

# Project data snapshot.
!data/
!data/**

# Experiment results snapshot.
!results/
!results/**

